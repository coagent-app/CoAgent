{
  "productName": "Co-Agent",
  "version": "0.2.0",
  "identifier": "com.coagent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://localhost:1420 asset: http://asset.localhost; connect-src 'self' ws://localhost:7830 http://localhost:7830 https://backend.composio.dev https://api.openai.com https://api.voyageai.com; img-src 'self' asset: http://asset.localhost blob: data: https://logos.composio.dev; media-src 'self' asset: http://asset.localhost blob: mediastream:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true
      }
    },
    "windows": [
      {
        "title": "Co-Agent",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      },
      {
        "label": "voice-pill",
        "title": "Voice",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 440,
        "height": 80,
        "visible": false,
        "resizable": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": [
      "binaries/coagent-server",
      "binaries/coagent-memory"
    ]
  }
}
