{
  "productName": "Co-Agent",
  "version": "0.4.13",
  "identifier": "com.coagent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://localhost:1420 asset: http://asset.localhost; connect-src 'self' ws://localhost:7830 http://localhost:7830 https://backend.composio.dev https://api.openai.com https://api.voyageai.com https://*.workers.dev; img-src 'self' asset: http://asset.localhost blob: data: https://logos.composio.dev https://t3.gstatic.com; media-src 'self' asset: http://asset.localhost blob: mediastream:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true
      }
    },
    "windows": [
      {
        "title": "Co-Agent",
        "width": 1200,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false
      },
      {
        "label": "voice-pill",
        "title": "Voice",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 440,
        "height": 80,
        "visible": false,
        "resizable": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": "v1Compatible",
    "externalBin": [
      "binaries/coagent-server",
      "binaries/coagent-memory",
      "binaries/node",
      "binaries/whisper"
    ],
    "resources": [
      "vendor/**/*"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": null,
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRTE5OTVGRTIyMjNDMUYKUldRZlBDTGlYNW5oWXoyWTBqRmhJL2RvUW1zMTdkdWc0cW9WSWt3Unc1VkZiUEVUa2ZjK2N4U3UK",
      "endpoints": [
        "https://github.com/coagent-app/CoAgent/releases/latest/download/latest.json"
      ]
    }
  }
}
