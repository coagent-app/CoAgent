# CoAgent — API Keys
# Configure these in the app: Settings → API Keys
# Or copy this file to ~/.coagent/.env and fill in your keys.

# Required — powers the AI agent
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — enables Gmail, Calendar, Slack, and 80+ integrations
# Get a key at https://composio.dev
COMPOSIO_API_KEY=

# Optional — enables semantic file search
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — enables Google Calendar sync
# Create at https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
