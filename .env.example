# CoAgent — Environment Variables
# Copy to .env (project root) or ~/.coagent/.env (per-user)
# See setup.md for full documentation.

# ── Core (Required) ──────────────────────────────────────────────────────────

# Powers the AI agent — required unless using a relay
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── LLM Alternatives (Optional) ─────────────────────────────────────────────

# Kimi K2.5 — cost-effective alternative model
# https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Embeddings (semantic file search), Whisper (voice), TTS
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Integrations (Optional) ─────────────────────────────────────────────────

# 80+ integrations — Gmail, Slack, Calendar, CRM, etc.
# https://composio.dev
COMPOSIO_API_KEY=

# Semantic web search & structured extraction
# https://exa.ai
EXA_API_KEY=

# ── Google Calendar (Optional) ───────────────────────────────────────────────

# OAuth 2.0 Client ID (Desktop app type)
# https://console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Relay / Teams (Optional) ────────────────────────────────────────────────

# Connect to a hosted relay for multi-user or team mode
RELAY_URL=
RELAY_TOKEN=
RELAY_USER_ID=

# ── Server Config (Optional) ────────────────────────────────────────────────

# Override data directory (default: ~/.coagent)
# COAGENT_DATA_DIR=

# Agent server port (default: 7830)
# COAGENT_PORT=7830

# Webhook server port (default: 7831)
# WEBHOOK_PORT=7831

# HMAC secret for webhook validation
# WEBHOOK_SECRET=

# ── Build / Edition (Optional) ──────────────────────────────────────────────

# Edition vertical: personal, real-estate, sales, ecommerce, agency
# COAGENT_VERTICAL=personal

# Enable multi-agent team features
# COAGENT_TEAM=false
